<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".PengaturanActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPengaturan"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/green_primary"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white"
        app:title="@string/judul_pengaturan"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- KARTU 1: Profil & Lokasi -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSholatKu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/JudulKartu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/judul_profil" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_nama">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNama"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_kota">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etKota"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTU 2: Tampilan -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSholatKu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/JudulKartu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/judul_tampilan" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchTema"
                        style="@style/SwitchSalat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tema_gelap" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KARTU 3: Pengingat -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardSholatKu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/JudulKartu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/judul_pengingat" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSubuh"
                        style="@style/SwitchSalat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/pengingat_subuh" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchZuhur"
                        style="@style/SwitchSalat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pengingat_zuhur" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAsar"
                        style="@style/SwitchSalat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pengingat_asar" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMagrib"
                        style="@style/SwitchSalat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pengingat_magrib" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchIsya"
                        style="@style/SwitchSalat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pengingat_isya" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/tombol_simpan"
                app:cornerRadius="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="@string/info_pengaturan"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
